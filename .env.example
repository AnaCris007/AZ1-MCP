# Copie este arquivo para .env e preencha os valores.
#   cp .env.example .env
#
# O .env é lido a partir do diretório onde você roda o comando (subindo na
# árvore de pastas) e, como fallback, do diretório do kit. Ou seja: dá para
# manter um .env por projeto, ou um único aqui dentro do kit.

# URL base da instância — CONFIRA ANTES DE RODAR.
# Apontar para a instância errada devolve 401 mesmo com token válido.
# Inteli:  https://git.inteli.edu.br
# Público: https://gitlab.com
GITLAB_URL=https://git.inteli.edu.br

# Personal Access Token com escopo `api`, gerado NA MESMA instância do
# GITLAB_URL acima — um token do gitlab.com não vale no git.inteli.edu.br.
# GitLab → Preferences → Access Tokens → Add new token → scope: api
#
# Precisa ser `api`, NÃO `read_api`: com read_api toda leitura funciona e
# só a criação falha com 403 — e o --dry-run não detecta, porque não usa rede.
# Defina a expiração para depois do fim do módulo, senão o kit para no meio.
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx

# ID numérico do projeto (não o nome).
# GitLab → Projeto → Settings → General → topo da página
GITLAB_PROJECT_ID=00000000

# Armazenamento de áudio compatível com S3. Ao executar a API diretamente no
# host, use localhost. Entre contêineres do docker-compose, use
# AUDIO_STORAGE_ENDPOINT_URL=http://minio:9000.
AUDIO_STORAGE_ENDPOINT_URL=http://localhost:9000
AUDIO_STORAGE_BUCKET=az1-audio
AUDIO_STORAGE_REGION=us-east-1
AUDIO_STORAGE_ACCESS_KEY=minioadmin
AUDIO_STORAGE_SECRET_KEY=minioadmin

# Chave de API do Deepgram para transcrição de áudio (Speech to Text).
# Obtenha em: https://console.deepgram.com
DEEPGRAM_API_KEY=

# Teste rápido antes de criar um lote (só leitura, não escreve nada).
# 200 nos dois = credenciais e instância corretas; 401 = token ou URL errados.
#   curl -s -o /dev/null -w "%{http_code}\n" -H "PRIVATE-TOKEN: $GITLAB_TOKEN" \
#     "$GITLAB_URL/api/v4/user"
#   curl -s -o /dev/null -w "%{http_code}\n" -H "PRIVATE-TOKEN: $GITLAB_TOKEN" \
#     "$GITLAB_URL/api/v4/projects/$GITLAB_PROJECT_ID"

# Chave gratuita do Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite (opcional — deixe comentado para usar o padrão)
